<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name=".PaseoWearListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data
          android:scheme="wear"
          android:host="*"
          android:path="/paseo-glance/request" />
      </intent-filter>
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
        <data
          android:scheme="wear"
          android:host="*"
          android:pathPrefix="/paseo-glance/voice/v1/" />
      </intent-filter>
    </service>
  </application>
</manifest>
